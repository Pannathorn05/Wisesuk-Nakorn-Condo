# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เรียบร้อยก่อนรัน
# หมายเหตุ: .env ถูก gitignore ไว้ ห้าม commit ค่าจริงเข้า repo

APP_ENV=development
PORT=8080

# ---------------------------------------------------------------- ฐานข้อมูล
POSTGRES_USER=wisetsuk
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านนี้
POSTGRES_DB=wisetsuk

# ใช้เมื่อรัน go run นอก Docker (ใน Docker ค่านี้ถูกตั้งให้อัตโนมัติโดย compose)
DATABASE_URL=postgres://wisetsuk:เปลี่ยนรหัสผ่านนี้@localhost:5432/wisetsuk?sslmode=disable

# ---------------------------------------------------------------- ความปลอดภัย
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -base64 48
JWT_SECRET=เปลี่ยนค่านี้เป็นสตริงสุ่มยาวอย่างน้อย32ตัวอักษร
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAY=30
BCRYPT_COST=12

# ---------------------------------------------------------------- ไฟล์อัปโหลด
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- CORS
# โดเมนของหน้าเว็บ คั่นด้วยเครื่องหมายจุลภาค
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------- ข้อมูลตั้งต้น
# รหัสผ่านของบัญชีผู้ดูแลที่ cmd/seed สร้าง — เปลี่ยนทันทีหลังเข้าสู่ระบบครั้งแรก
SEED_DEFAULT_PASSWORD=Wisetsuk!2026

# ---------------------------------------------------------------- pgAdmin
# เข้าใช้งานที่ http://localhost:5050 (เปิดเฉพาะจากเครื่องนี้เท่านั้น)
PGADMIN_EMAIL=admin@wisetsuk.com
PGADMIN_PASSWORD=เปลี่ยนรหัสผ่านนี้
PGADMIN_PORT=5050
