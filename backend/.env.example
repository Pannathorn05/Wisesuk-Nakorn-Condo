# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เรียบร้อยก่อนรัน
# หมายเหตุ: .env ถูก gitignore ไว้ ห้าม commit ค่าจริงเข้า repo

APP_ENV=development
PORT=8080

# ---------------------------------------------------------------- ฐานข้อมูล
POSTGRES_USER=wisetsuk
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านนี้
POSTGRES_DB=wisetsuk

# ใช้เมื่อรัน go run นอก Docker (ใน Docker ค่านี้ถูกตั้งให้อัตโนมัติโดย compose)
DATABASE_URL=postgres://wisetsuk:เปลี่ยนรหัสผ่านนี้@localhost:5432/wisetsuk?sslmode=disable

# ---------------------------------------------------------------- ความปลอดภัย
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -base64 48
JWT_SECRET=เปลี่ยนค่านี้เป็นสตริงสุ่มยาวอย่างน้อย32ตัวอักษร
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAY=30
BCRYPT_COST=12

# ---------------------------------------------------------------- ไฟล์อัปโหลด
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- CORS
# โดเมนของหน้าเว็บ คั่นด้วยเครื่องหมายจุลภาค
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------- เข้าสู่ระบบด้วยบัญชีภายนอก
# เว้นว่างได้ — provider ที่ไม่ได้ตั้ง client id และ secret ครบทั้งคู่จะถูกปิดไปเอง
# และปุ่มของเจ้านั้นจะไม่ขึ้นที่หน้าเข้าสู่ระบบ
#
# Google:   https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application)
# Facebook: https://developers.facebook.com/apps → เพิ่ม product "Facebook Login"
#
# Redirect URI ที่ต้องไปลงทะเบียนกับทั้งสองเจ้า ต้องตรงเป๊ะทุกตัวอักษร:
#   {PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback
#   {PUBLIC_BASE_URL}/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# หน้าเว็บฝั่ง frontend ที่ผู้ใช้จะถูกส่งกลับไปหลังยืนยันตัวตนเสร็จ
# (backend จะต่อ ?code=... หรือ ?error=... ให้เอง)
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# ---------------------------------------------------------------- ข้อมูลตั้งต้น
# รหัสผ่านของบัญชีผู้ดูแลที่ cmd/seed สร้าง — เปลี่ยนทันทีหลังเข้าสู่ระบบครั้งแรก
SEED_DEFAULT_PASSWORD=Wisetsuk!2026

# รหัสผ่านตั้งต้นของบัญชีผู้ดูแลที่หัวหน้าผู้ดูแลสร้างจากหน้าเว็บ
# (ฟอร์ม "เพิ่มผู้ดูแลใหม่" ไม่มีช่องรหัสผ่าน ระบบจึงตั้งให้จากค่านี้)
# บัญชีที่ได้รหัสนี้ถูกปักธง must_change_password ต้องตั้งรหัสใหม่ก่อนใช้งานจริง
# ไม่ตั้งค่าไว้ จะใช้ค่าเดียวกับ SEED_DEFAULT_PASSWORD
STAFF_DEFAULT_PASSWORD=Wisetsuk!2026

# ---------------------------------------------------------------- pgAdmin
# เข้าใช้งานที่ http://localhost:5050 (เปิดเฉพาะจากเครื่องนี้เท่านั้น)
PGADMIN_EMAIL=admin@wisetsuk.com
PGADMIN_PASSWORD=เปลี่ยนรหัสผ่านนี้
PGADMIN_PORT=5050
